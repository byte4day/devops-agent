{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devops-agent/devops-agent/blob/main/schemas/devops.schema.json",
  "title": "DevOps Agent project configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "default_environment": {"enum": ["preview", "staging", "production"]},
    "allowed_targets": {"type": "array", "minItems": 1, "items": {"enum": ["preview", "staging", "production"]}},
    "build_commands": {"$ref": "#/$defs/commands"},
    "test_commands": {"$ref": "#/$defs/commands"},
    "health_urls": {"type": "array", "items": {"type": "string", "format": "uri", "pattern": "^https?://"}},
    "max_repair_attempts": {"type": "integer", "minimum": 0, "maximum": 3},
    "command_timeout": {"type": "integer", "minimum": 1, "maximum": 1800},
    "approval_policy": {"type": "object", "additionalProperties": false, "properties": {"require_production_approval": {"const": true}}},
    "aws_bucket": {"type": "string", "minLength": 1},
    "aws_prefix": {"type": "string", "minLength": 1},
    "aws_region": {"type": "string", "minLength": 1},
    "aws_account_id": {"type": "string", "minLength": 1},
    "oss_bucket": {"type": "string", "minLength": 1},
    "oss_prefix": {"type": "string", "minLength": 1},
    "production_branch": {"type": "string", "minLength": 1},
    "preview_branch": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}
